# Optional Web3Forms access key for instant waitlist email notifications.
# Sign up free at https://web3forms.com with design.amonite@gmail.com, then paste
# the Access Key below. It is client-safe (Web3Forms keys are public by design).
# Every waitlist submission emails the account inbox: email, discipline, tier, timestamp.
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=

# Optional Google Apps Script Web App URL to append waitlist entries directly to your Google Sheet
# Deploy your Google Sheet Apps Script as a Web App (access: "Anyone") and paste the exec URL here:
NEXT_PUBLIC_WAITLIST_SHEET_URL=
